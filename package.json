{
  "name": "endfield-cloud-client",
  "version": "1.0.0",
  "description": "Lightweight Chromium wrapper for the Endfield cloud game, optimized for Steam Deck (Arch Linux)",
  "main": "src/main.js",
  "author": "roderickezreal",
  "license": "MIT",
  "homepage": "https://endfield.hypergryph.com/cloud",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:debug": "electron . --enable-logging=stderr --v=1",
    "start:no-gpu": "electron . --disable-gpu",
    "start:wayland": "electron . --enable-features=UseOzonePlatform --ozone-platform=wayland",
    "build:linux": "electron-builder --linux AppImage --x64",
    "build:linux-debug": "electron-builder --linux --dir --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {},
  "build": {
    "appId": "site.roderickezreal.endfield-cloud-client",
    "productName": "Endfield Cloud",
    "copyright": "Copyright © 2026 roderickezreal",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "src/**/*",
      "resources/icon.png",
      "resources/icon.svg",
      "package.json",
      "!**/.DS_Store",
      "!**/node_modules/.cache"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": ["**/*"]
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "category": "Game",
      "synopsis": "Endfield cloud game wrapper for Steam Deck",
      "description": "Lightweight Chromium-based shell that loads the official Endfield cloud game webpage. Designed for Steam Deck (Arch Linux). Native Web Gamepad API pass-through, persistent cookie session, GPU/Vulkan acceleration.",
      "executableName": "endfield-cloud-client",
      "icon": "resources/icons",
      "desktop": {
        "Name": "Endfield Cloud",
        "Comment": "Endfield cloud game wrapper",
        "Categories": "Game;",
        "Keywords": "endfield;cloud-game;steam-deck;"
      },
      "artifactName": "endfield-cloud-client-${version}.${ext}"
    }
  }
}
