# ============================================================
# Endfield Cloud Client .gitignore
# ============================================================

# 依赖
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 构建产物
dist/
build/
*.AppImage
*.AppImage.zsync
*.deb
*.rpm
*.snap
*.tar.gz

# Electron 缓存
.electron/
.cache/

# 用户数据 / 会话缓存(若放在仓库内)
/userData/
*.log
.DS_Store
Thumbs.db

# 编辑器
.vscode/
.idea/
*.swp
*.swo

# 图标占位 / 测试产物
resources/icons/*.bak
resources/icons/_unused/

# npm lock + 自动生成的 PNG(由 build 脚本产出)
package-lock.json
resources/icons/*.png

# 本地辅助文档(不上传)
UPLOAD_GITHUB.txt
LOCAL_*.txt
NOTES_*.md
